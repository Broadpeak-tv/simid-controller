{
  "name": "@broadpeak-tv/simid-controller",
  "version": "0.9.0",
  "description": "SIMID controller",
  "author": "Broadpeak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Broadpeak-tv/simid-controller.git"
  },
  "type": "module",
  "main": "./dist/index.js",
