    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-typescript": "12.1.2",
    "@types/node": "22.13.10",
    "rimraf": "6.0.1",
    "rollup": "4.40.0",
    "rollup-plugin-dts": "6.2.1",
    "typedoc": "0.25.7",
    "typescript": "4.9.5"
  }
