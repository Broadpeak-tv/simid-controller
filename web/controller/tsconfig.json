{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2018", "DOM"],
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "inlineSourceMap": false,
    "declarationDir": "dist/types",
    "outDir": "dist",
    "strict": false,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "typeRoots": [
      "node_modules/@types"
    ],
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*"
  ]
}
